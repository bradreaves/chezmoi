# Claude Code shortcuts
abbr --add cc "claude --model default"
abbr --add ccr "claude --resume"
abbr --add ccc "claude --continue"
abbr --add ccf "claude --continue --fork-session"
abbr --add ccd "claude --model default --allow-dangerously-skip-permissions"
abbr --add ccdr "claude --allow-dangerously-skip-permissions --resume"

# Claude Code model shortcuts
abbr --add opus "claude --model opus[1m] --allow-dangerously-skip-permissions"
abbr --add sonnet "claude --model sonnet --allow-dangerously-skip-permissions"
abbr --add haiku "claude --model haiku --allow-dangerously-skip-permissions"

abbr --add opus46 "claude --model claude-opus-4-6[1m] --allow-dangerously-skip-permissions"

