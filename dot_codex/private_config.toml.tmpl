{{- $uvx := joinPath .chezmoi.homeDir ".local/bin/uvx" -}}
{{- $npx := "npx" -}}
{{- $brewPrefix := "/usr/local" -}}
{{- if eq .chezmoi.arch "arm64" -}}{{- $brewPrefix = "/opt/homebrew" -}}{{- end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $uvx = joinPath $brewPrefix "bin/uvx" -}}
{{- $npx = joinPath $brewPrefix "bin/npx" -}}
{{- end -}}
# Portable Codex preferences. Restore prerequisites are documented in the source
# repository: .docket/2026-10-23-codex-restore.md.
# Credentials, project trust, host integration paths and cache state are excluded.

model = "gpt-6.1-sol"
model_reasoning_effort = "high"
project_doc_fallback_filenames = ["CLAUDE.md"]
approvals_reviewer = "auto_review"
service_tier = "default"

[features]
hooks = true
js_repl = false

[tui]
status_line = ["model-with-reasoning", "current-dir", "approval-mode", "context-used"]
status_line_use_colors = true
session_picker_view = "dense"
agents_overview_grouping = "status"

[desktop]
conversationDetailMode = "STEPS_PROSE"
ambient-suggestions-enabled = false
followUpQueueMode = "queue"

[marketplaces."claude-plugins-official"]
source_type = "git"
source = "https://github.com/anthropics/claude-plugins-official.git"

[marketplaces."bgr-claude-plugins"]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/src/bgr-claude-plugins"

[marketplaces."marimo-pair"]
source_type = "git"
source = "https://github.com/marimo-team/marimo-pair.git"

[marketplaces."teaching-tools"]
source_type = "local"
source = "{{ .chezmoi.homeDir }}/Library/CloudStorage/GoogleDrive-bgreaves@ncsu.edu/My Drive/_Teaching/teaching-tools"

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."commit-commands@claude-plugins-official"]
enabled = true

[plugins."feature-dev@claude-plugins-official"]
enabled = true

[plugins."frontend-design@claude-plugins-official"]
enabled = true

[plugins."github@claude-plugins-official"]
enabled = true

[plugins."playwright@claude-plugins-official"]
enabled = true

[plugins."plugin-dev@claude-plugins-official"]
enabled = true

[plugins."docket@bgr-claude-plugins"]
enabled = true

[plugins."longhand@bgr-claude-plugins"]
enabled = true

[plugins."sourcehut@bgr-claude-plugins"]
enabled = true

[plugins."google-calendar@openai-curated"]
enabled = true

[plugins."slack@claude-plugins-official"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."marimo-pair@marimo-pair"]
enabled = true

[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."lms@teaching-tools"]
enabled = true

[plugins."csc774@teaching-tools"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[plugins."code-review@openai-bundled"]
enabled = true

[mcp_servers."mcp-obsidian"]
command = {{ $uvx | quote }}
args = ["--with", "mcp<2", "mcp-obsidian"]
env_vars = ["OBSIDIAN_API_KEY"]

[mcp_servers."time"]
command = {{ $uvx | quote }}
args = ["--with", "mcp<2", "mcp-server-time", "--local-timezone", "America/New_York"]

[mcp_servers."whois"]
command = {{ $npx | quote }}
args = ["-y", "@bharathvaj/whois-mcp@latest"]

[mcp_servers."whois".env]
{{ if eq .chezmoi.os "darwin" -}}
PATH = "{{ $brewPrefix }}/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{ end -}}

[mcp_servers."zotero"]
command = {{ $uvx | quote }}
args = ["--python", "3.12", "--with", "mcp<2", "--from", "zotero-mcp-server[semantic]==0.13.0", "zotero-mcp"]

[mcp_servers."zotero".env]
ZOTERO_EMBEDDING_MODEL = "default"
ZOTERO_LOCAL = "true"

[mcp_servers."github"]
url = "https://api.githubcopilot.com/mcp/"
bearer_token_env_var = "GITHUB_PERSONAL_ACCESS_TOKEN"

[mcp_servers."powerpoint-web"]
command = {{ $npx | quote }}
args = ["-y", "@playwright/mcp@latest", "--isolated"]

[mcp_servers."powerpoint-web".env]
{{ if eq .chezmoi.os "darwin" -}}
PATH = "{{ $brewPrefix }}/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{ end -}}
